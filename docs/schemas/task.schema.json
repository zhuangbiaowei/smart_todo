{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-todo.local/schemas/task.schema.json",
  "title": "SmartTodo Task",
  "description": "Canonical task object returned by SmartTodo HTTP and Ruby APIs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "parent_id",
    "priority",
    "task_type",
    "requirements",
    "acceptance_criteria",
    "success_criteria",
    "failure_criteria",
    "required_skills",
    "metadata",
    "created_at",
    "updated_at",
    "actual_executor",
    "completion_status",
    "task_result",
    "execution_logs",
    "dependencies",
    "children",
    "assignments",
    "reports"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "failed", "suspended", "blocked"]
    },
    "parent_id": {
      "type": ["string", "null"]
    },
    "priority": {
      "type": "integer"
    },
    "task_type": {
      "type": "string",
      "enum": ["simple", "sequential", "parallel", "recurring", "branching"]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "suggested_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skill_instructions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failure_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "actual_executor": {
      "type": ["string", "null"]
    },
    "completion_status": {
      "type": ["string", "null"]
    },
    "task_result": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "summary": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": true
        },
        "next_actions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "execution_logs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "children": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["agent_id", "assigned_at"],
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "assigned_at": {
            "type": "string",
            "format": "date-time"
          },
          "agent_skills": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["agent_id", "result", "detail", "reported_at"],
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "summary": {
            "type": ["string", "null"]
          },
          "detail": {
            "type": "object",
            "additionalProperties": true
          },
          "reported_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
